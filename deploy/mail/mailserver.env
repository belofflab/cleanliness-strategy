# Базовая конфигурация docker-mailserver для blanq.tech.
# Полный список опций: https://docker-mailserver.github.io/docker-mailserver/latest/config/environment/
OVERRIDE_HOSTNAME=mail.blanq.tech
POSTMASTER_ADDRESS=postmaster@blanq.tech

# TLS от Let's Encrypt (сертификат mail.blanq.tech выпускает certbot на хосте).
SSL_TYPE=letsencrypt

# Безопасность/антиспам (можно отключить для экономии памяти на 4 ГБ сервере).
ENABLE_SPAMASSASSIN=0
ENABLE_CLAMAV=0
ENABLE_FAIL2BAN=1
ENABLE_POSTGREY=0
ONE_DIR=1
PERMIT_DOCKER=connected-networks

# DKIM включается после генерации ключа (см. SETUP.md).
ENABLE_OPENDKIM=1
ENABLE_OPENDMARC=1

# Если исходящий порт 25 заблокирован хостером — укажите SMTP-релей (пример sendgrid/yandex):
# RELAY_HOST=smtp.yandex.ru
# RELAY_PORT=587
# RELAY_USER=postmaster@blanq.tech
# RELAY_PASSWORD=__app_password__

