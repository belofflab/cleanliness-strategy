# ==========================================================================
# Точка Чистоты — PRODUCTION окружение.
# Скопируйте в deploy/.env на сервере и заполните реальными значениями:
#   cp deploy/.env.production.example deploy/.env
# Файл deploy/.env в .gitignore — НИКОГДА не коммитьте секреты.
# ==========================================================================

# ===== Общие =====
ENVIRONMENT=production

# ===== Публикация портов на хосте (для nginx) =====
# На общем сервере, где порт 3000/8000 уже занят, измените значения
# и приведите upstream в nginx-конфиге к тем же портам.
WEB_HOST_PORT=3000
API_HOST_PORT=8000

# ===== Frontend (Next.js) =====
# NEXT_PUBLIC_* инлайнятся в бандл при сборке образа в CI (.github/workflows);
# здесь — для локальной сборки/справки.
NEXT_PUBLIC_SITE_URL=https://cleanliness.pro
NEXT_PUBLIC_API_URL=https://api.cleanliness.pro/api/v1

# ===== PostgreSQL =====
POSTGRES_USER=tochka
# ОБЯЗАТЕЛЬНО смените на длинный случайный пароль (например: openssl rand -hex 24).
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=tochka
# DSN должен совпадать с парой user/password/db выше. Хост = имя сервиса compose.
DATABASE_URL=postgresql+asyncpg://tochka:CHANGE_ME_STRONG_PASSWORD@postgres:5432/tochka

# ===== Redis =====
REDIS_URL=redis://redis:6379/0

# ===== Celery =====
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ===== CORS (JSON-массив доменов фронтенда) =====
CORS_ORIGINS=["https://cleanliness.pro","https://www.cleanliness.pro","https://ufa.cleanliness.pro","https://tyumen.cleanliness.pro"]

# ===== Регионы =====
# Город по умолчанию (apex-домен, заявки/звонки без города) и базовый домен поддоменов.
DEFAULT_CITY_SLUG=ufa
PUBLIC_BASE_DOMAIN=cleanliness.pro

# ===== JWT (ОБЯЗАТЕЛЬНО) =====
# Сгенерируйте: openssl rand -hex 32. Дефолтное значение в production не запускается.
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
# Отдельный ключ хешей OTP-кодов и refresh-токенов: openssl rand -hex 32.
# Пусто = используется JWT_SECRET (с предупреждением в логе при старте).
TOKEN_HMAC_SECRET=CHANGE_ME_64_HEX_CHARS

# ===== Rate limiting (Redis) =====
RATE_LIMIT_ENABLED=true
TRUST_PROXY_HEADERS=true

# ===== Telegram (мгновенное уведомление операторов о лиде) =====
# Пусто = mock-режим. Бот создаётся через @BotFather, chat_id — id чата/группы.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Calltracking.ru (динамический коллтрекинг) =====
# URL уведомлений в кабинете CT:
# https://api.cleanliness.pro/api/v1/integrations/calltracking/webhook?secret=<значение>
CALLTRACKING_WEBHOOK_SECRET=
# Карта подменных номеров → город (JSON), напр.: {"+79990000001":"tyumen","+79990000002":"ufa"}
CALLTRACKING_CITY_NUMBERS=

# ===== Яндекс.Метрика: офлайн-конверсии (обучение автостратегий Директа) =====
YANDEX_METRIKA_TOKEN=
YANDEX_METRIKA_COUNTER_ID=109824753
YANDEX_METRIKA_GOAL_DONE=CleaningDone

# ===== S3 / Yandex Object Storage (медиа) =====
S3_ENABLED=false
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ===== SMS (OTP-вход) — sms.ru =====
# Для боевого входа в мобильном приложении включите и укажите api_id.
SMS_ENABLED=false
SMS_RU_API_ID=

# ===== Sentry (мониторинг ошибок) =====
SENTRY_DSN=

# ===== Логирование =====
LOG_LEVEL=INFO
LOG_JSON=true

# ===== Стек наблюдаемости (docker-compose.monitoring.yml) =====
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME
GRAFANA_PORT=3001
UPTIME_KUMA_PORT=3002
