# ===== Общие =====
# Окружение: development | production
ENVIRONMENT=development

# ===== Frontend (Next.js) =====
# Публичный канонический URL для SEO-метаданных
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Базовый URL backend API для клиента (через Nginx в проде, напрямую в dev)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ===== PostgreSQL =====
POSTGRES_USER=tochka
POSTGRES_PASSWORD=tochka
POSTGRES_DB=tochka
# DSN для backend (async-драйвер asyncpg). Хост = имя сервиса в compose.
DATABASE_URL=postgresql+asyncpg://tochka:tochka@postgres:5432/tochka

# ===== Redis =====
REDIS_URL=redis://redis:6379/0

# ===== Celery (фоновые задачи) =====
# Отдельные базы Redis под брокер и результаты.
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ===== CORS (домены фронтенда, через запятую в JSON-формате) =====
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ===== Регионы =====
# Город по умолчанию для заявок/звонков/контента без явного города
# (совпадает с DEFAULT_CITY_SLUG в apps/web/lib/city.ts и EXPO_PUBLIC_DEFAULT_CITY).
DEFAULT_CITY_SLUG=ufa
# Базовый домен: <slug>.<домен> — городские поддомены, apex — город по умолчанию.
PUBLIC_BASE_DOMAIN=cleanliness.pro


# ===== Calltracking.ru (динамический коллтрекинг) =====
# Секрет вебхука: URL уведомлений в кабинете CT —
# https://api.cleanliness.pro/api/v1/integrations/calltracking/webhook?secret=<значение>
# Пустой секрет = вебхук отключён.
CALLTRACKING_WEBHOOK_SECRET=
# Карта подменных номеров → город (JSON), напр.: {"+79990000001":"tyumen","+79990000002":"ufa"}
CALLTRACKING_CITY_NUMBERS=

# ===== Яндекс.Метрика: офлайн-конверсии (обучение автостратегий Директа) =====
# OAuth-токен с правом на управление счётчиком; пусто = mock-режим (лог без отправки).
YANDEX_METRIKA_TOKEN=
YANDEX_METRIKA_COUNTER_ID=109824753
# Название офлайн-цели в Метрике (тип «Офлайн»); импортируется в Директ автоматически.
YANDEX_METRIKA_GOAL_DONE=CleaningDone

# ===== S3 / Yandex Object Storage (медиа) =====
# ВНИМАНИЕ: реальные ключи держите ТОЛЬКО здесь (deploy/.env в .gitignore),
# никогда не коммитьте. Рекомендуется отдельный сервисный аккаунт с минимумом прав.
S3_ENABLED=false
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ===== SMS (OTP-вход) — sms.ru =====
SMS_ENABLED=false
SMS_RU_API_ID=

# ===== Telegram (мгновенное уведомление операторов о лиде) =====
# Пусто = mock-режим. Бот создаётся через @BotFather, chat_id — id чата/группы.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== JWT (аутентификация) =====
JWT_SECRET=change-me-in-production
# Отдельный ключ хешей OTP-кодов и refresh-токенов (openssl rand -hex 32).
# Пусто = используется JWT_SECRET (совместимость); в production задайте оба.
TOKEN_HMAC_SECRET=

# ===== Rate limiting (Redis; лимиты — services/api/app/core/rate_limit.py) =====
RATE_LIMIT_ENABLED=true
# За Nginx IP клиента берётся из X-Real-IP / X-Forwarded-For.
TRUST_PROXY_HEADERS=true

# ===== Sentry (мониторинг ошибок) =====
SENTRY_DSN=

# ===== Логирование (структурные JSON-логи под Vector/Promtail/Loki) =====
# Уровень: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# true — JSON-строки (прод, сборщики логов); false — человекочитаемо (dev)
LOG_JSON=true

# ===== Стек наблюдаемости (docker-compose.monitoring.yml) =====
# Grafana: логин/пароль администратора и порт UI.
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3001
# Uptime Kuma: порт Web UI (пинг /health + алерты в Telegram настраиваются в UI).
UPTIME_KUMA_PORT=3002
