{
  "name": "tochka-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "go": "node scripts/dev.mjs",
    "go:tunnel": "node scripts/dev.mjs --tunnel",
    "go:api-tunnel": "node scripts/dev.mjs --tunnel --api-tunnel",
    "android": "expo run:android",
    "android:apk": "eas build --platform android --profile preview",
    "android:apk:local": "eas build --platform android --profile preview --local",
    "ios": "expo run:ios",
    "ios:device": "APP_VARIANT=dev expo run:ios --device",
    "prebuild:clean": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "doctor": "npx expo-doctor",
    "fix-deps": "npx expo install --fix",
    "export:check": "expo export --platform ios --platform android --output-dir .expo/export-check"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^54.0.37",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2",
    "babel-preset-expo": "~54.0.10"
  },
  "private": true
}
