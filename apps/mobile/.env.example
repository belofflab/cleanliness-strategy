# Базовый URL backend API (всегда с /api/v1 на конце).
#
# Для запуска на телефоне через `npm run go` этот адрес подставляется АВТОМАТИЧЕСКИ
# (IP компьютера в локальной сети, см. scripts/dev.mjs и docs/FREE_TESTING_GUIDE.md) —
# значение из .env используется только при обычном `expo start` / симуляторах.
#
# Симулятор iOS / web на этой же машине:
#   EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
# Android-эмулятор -> хост-машина:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
# Реальное устройство в той же сети (IP машины; `npm run go` делает это сам):
#   EXPO_PUBLIC_API_URL=http://192.168.1.50:8000/api/v1
# Production (боевой API; так собираются preview/production-сборки в eas.json):
#   EXPO_PUBLIC_API_URL=https://api.cleanliness.pro/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Город по умолчанию для расчётов и слотов (совпадает с DEFAULT_CITY_SLUG бэкенда).
EXPO_PUBLIC_DEFAULT_CITY=ufa
