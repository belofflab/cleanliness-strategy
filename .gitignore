# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (монорепо: артефакты в apps/*)
/.next/
**/.next/
/out/
**/out/

# production
/build

# misc
.DS_Store
*.pem

# IDE
.idea/
.vscode/*
!.vscode/extensions.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets ignored, *.example templates tracked)
.env*
!.env.example
!.env*.example
!*.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ===== Backend (services/api) =====
# Виртуальные окружения Python
.venv/
**/.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
# Локальные файлы окружения деплоя
deploy/.env

# ===== Mobile (apps/mobile — Expo / React Native) =====
.expo/
**/.expo/
apps/mobile/dist/
apps/mobile/web-build/
apps/mobile/ios/
apps/mobile/android/
expo-env.d.ts
# Релизные сборки (никогда не коммитим — тяжёлые артефакты)
*.apk
*.aab
*.ipa
*.keystore
*.mobileprovision

.claude/

# SIP: боевой конфиг с паролем генерируется из template на сервере
deploy/sip/pjsip.conf

# Celery beat: runtime-файл расписания (dbm) — не хранится в git
services/api/celerybeat-schedule*
